# Copy to .env and adjust. The compose file provides sane dev defaults inline;
# these are the knobs you are most likely to change.
DATABASE_URL=postgres://postgres:postgres@db:5432/vnn
ACTIVE_COMPETITION=vnn
EXECUTION_BACKEND=local_docker   # aws | local_docker
MAX_PARALLEL_NODES=1
SCHEDULER_AUTOSTART=False        # True to run the background job in the web process
ROOT_URL=http://backend:8000     # must be reachable by the worker (node callbacks)
SECRET_KEY=dev-insecure
DEBUG=True
